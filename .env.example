# ---------------------------------------------------------------------------
# Coverse configuration. Copy to .env; every value below has a working default.
# ---------------------------------------------------------------------------

# --- AI provider ---
# mock       zero setup, fake streaming, no keys. The default.
# ollama     a real model running locally.
# openrouter hosted models through one API key.
AI_PROVIDER=mock

# Optional override; otherwise the provider's own default model is used.
AI_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# How fast the mock provider "types".
MOCK_DELAY_MS=25

# --- database ---
# SQLite by default so the stack runs with nothing installed. For Supabase use
# the pooled connection string with the asyncpg driver:
#   postgresql+asyncpg://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./coverse.db

# --- auth ---
# Leave blank to run in keyless dev mode, where the token is trusted as a user
# id. Set AUTH_REQUIRED=true in production so that mode can never be used.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REQUIRED=false

# --- server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- tuning ---
# Batch window for committing streamed tokens into the CRDT.
STREAM_FLUSH_MS=50
# Debounced write-back of Yjs updates.
PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_WAIT_MS=10000
COMPACT_AFTER_UPDATES=200
