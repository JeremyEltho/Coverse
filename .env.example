# ---------------------------------------------------------------------------
# Coverse configuration. Copy to .env; every value below has a working default.
# ---------------------------------------------------------------------------

# --- AI provider ---
# mock       zero setup, fake streaming, no keys. The default.
# ollama     a real model running locally.
# openrouter hosted models through one API key.
AI_PROVIDER=mock

# Optional override; otherwise the provider's own default model is used.
AI_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# How fast the mock provider "types".
MOCK_DELAY_MS=25

# --- rooms ---
# Rooms live in memory only: there is no database and nothing is written to
# disk. These two graces stop that from being hostile.
#
# How long an empty room survives, so that everyone refreshing at once does not
# destroy the session.
ROOM_GRACE_SECONDS=120
# How long a disconnected driver keeps the mic before it moves on, so one closed
# laptop cannot block the room.
DRIVER_GRACE_SECONDS=20
MAX_MEMBERS_PER_ROOM=12

# --- server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- streaming ---
# Batch window for committing streamed tokens into the shared document. One
# transaction per token would be a write storm against every connected client.
STREAM_FLUSH_MS=50
